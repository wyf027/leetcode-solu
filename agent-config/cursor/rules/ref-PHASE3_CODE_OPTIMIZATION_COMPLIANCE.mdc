## 3. Types 层规范

> Types 层定义模块的业务数据类型、Hook 返回类型、Handler 接口。
> API 响应类型必须复用全局 `ApiResponse<T>`，不重复定义。

### 3.1 Types 文件结构

```typescript
// types/buser/[module]/index.ts 标准结构
// ==================== 请求参数 ====================
export interface XxxPageParams { ... }

// ==================== 业务数据 ====================
export interface XxxItem { ... }

// ==================== 数据聚合 ====================
export type XxxListResult = PageData<XxxItem>;  // 复用全局 PageData

// ==================== API 响应类型（type alias） ====================
export type XxxListResponse = ApiResponse<XxxListResult | null>;
export type XxxCountResponse = ApiResponse<XxxCountData | null>;
export type XxxDeleteResponse = ApiResponse<string | null>;

// ==================== Hook 返回类型 ====================
export interface XxxPageHandlers { ... }
export interface XxxPaginationState { ... }
export interface UseXxxPageReturn { ... }
```

### 3.2 API 响应类型规范

**必须用 `type alias` 基于全局 `ApiResponse<T>` 定义，禁止用 `interface` 重复字段：**

```typescript
// ✅ 正确写法（messages 实际代码）
export type MessageListResponse = ApiResponse<MessageListResult | null>;
export type MessageTypeCountResponse = ApiResponse<MessageTypeCountData | null>;
export type DeleteMessageResponse = ApiResponse<string | null>;
export type MarkReadResponse = ApiResponse<string | null>;
export type LatestMessagesResponse = ApiResponse<MessageItem[] | null>;
```

```typescript
// ✅ 正确写法（dashboard 实际代码）
export type JobPositionPageResult = PageData<JobPositionItem>;
// 分页查询响应直接使用全局 PageResponse：
// PageResponse<JobPositionItem> = ApiResponse<PageData<JobPositionItem>>
```

### 3.3 Handler 接口规范

聚合 Hook 返回的 handlers 必须定义明确的 TypeScript 接口：

```typescript
// ✅ dashboard 实际代码
export interface DashboardPageHandlers {
  onEdit: (id: string) => void;
  onShare: (id: string) => void;
  onClose: (id: string) => Promise<void>;
  onModifyDeadline: (id: string, deadline: string) => Promise<void>;
  onModifySalary: (id: string, salaryRange: string) => Promise<void>;
  onDelete: (id: string) => Promise<void>;
}

export interface SearchPaginationHandlers {
  onSearchTypeChange: (type: JobSearchType) => void;
  onSearchValueChange: (value: string) => void;
  onDepartmentChange: (departmentId: string) => void;
  onSearch: () => void;
  onPageChange: (current: number, size: number) => void;
  onReset: () => void;
}

// ✅ messages 实际代码
export interface MessagePageHandlers {
  onMarkRead: (messageId: string) => Promise<void>;
  onDelete: (messageId: string) => Promise<void>;
  onReport: (id: string) => void;
  onContinue: (id: string) => void;
}
```

### 3.4 Hook 返回类型规范

```typescript
// ✅ 明确定义 Hook 返回类型接口
export interface UseDashboardPageReturn {
  initialLoading: boolean;
  jobListLoading: boolean;
  workbenchData: WorkbenchData | null;
  positionCards: JobPositionItem[];
  departmentOptions: DepartmentOption[];
  handlers: DashboardPageHandlers;

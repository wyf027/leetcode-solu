## 3. Hooks 开发规范

### 3.1 Hook 分层设计

```
hooks/buser/dashboard/
├── index.ts              # 统一导出
├── baseHooks.ts          # 基础 Hooks（单一 API 调用封装）
├── useDashboardPage.ts   # 聚合 Hook（组合多个 baseHooks）
└── mappers.ts            # 数据映射函数
```

| 文件                   | 职责                          | 示例                                   |
| ---------------------- | ----------------------------- | -------------------------------------- |
| **baseHooks.ts**       | 封装单个 API 调用             | `useWorkbenchData()`, `useDeleteJob()` |
| **use[Module]Page.ts** | 聚合多个 Hook，提供页面级接口 | `useDashboardPage()`                   |
| **mappers.ts**         | 数据格式转换                  | `mapDepartToOption()`                  |

### 3.2 baseHooks 编写规范

```typescript
// hooks/buser/dashboard/baseHooks.ts
import { useState, useCallback } from 'react';
import { checkResCode, unwrap } from '@/constants/utils';
import { getWorkbenchData } from '@/services/buser/dashboard';
import type { WorkbenchData } from '@/types/buser/dashboard';

/**
 * 获取工作台数据
 *
 * ✅ 使用 checkResCode 校验响应码
 * ✅ 使用 unwrap 解包数据
 * ✅ 统一的 loading/error 状态
 */
export function useWorkbenchData() {
  const [data, setData] = useState<WorkbenchData | null>(null);
  const [loading, setLoading] = useState(false);

  const fetchWorkbenchData = useCallback(async () => {
    try {
      setLoading(true);
      const res = await getWorkbenchData<ApiResponse<WorkbenchData>>();
      checkResCode(res); // 统一校验
      setData(unwrap(res)); // 统一解包
    } catch (error) {
      console.warn('获取工作台数据失败:', error);
    } finally {
      setLoading(false);
    }
  }, []);

  return { data, loading, fetchWorkbenchData };
}
```


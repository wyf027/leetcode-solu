## 4. Service 服务层规范

### 4.1 Service 文件结构

```typescript
// services/buser/dashboard/index.ts
import axiosInstance from '@/services/axiosConfig';

const BASE = '/B/workbenck';

/**
 * Service 层规范：
 * ✅ 只负责 HTTP 请求
 * ✅ 使用泛型支持类型推导
 * ✅ 统一的请求格式
 * ❌ 不包含业务逻辑
 * ❌ 不包含数据转换
 * ❌ 不包含错误提示
 */

/** GET 请求示例 */
export const getWorkbenchData = <T>(
  params?: Record<string, unknown>
): Promise<T> => {
  return axiosInstance.get(`${BASE}/getWorkbenchData`, { params });
};

/** POST 请求示例 */
export const getJobPositionPage = <T>(
  data: Record<string, unknown>
): Promise<T> => {
  return axiosInstance.post(`${BASE}/getJobPositionPage`, data);
};

/** PUT 请求示例 */
export const editSalaryRange = <T>(
  jobId: string | number,
  data?: Record<string, unknown>
): Promise<T> => {
  return axiosInstance.put(`${BASE}/editSalaryRange/${jobId}`, data ?? {});
};

/** DELETE 请求示例 */
export const deleteJobPosition = <T>(jobId: string | number): Promise<T> => {
  return axiosInstance.delete(`${BASE}/deleteJobPosition/${jobId}`);
};
```

### 4.2 Axios 配置

```typescript
// services/axiosConfig.ts
import axios from 'axios';
import { useUserStore } from '@/store/useUserStore';

const axiosInstance = axios.create({
  baseURL: process.env.NEXT_PUBLIC_API_BASE_URL,
  timeout: 30000,
  headers: { 'Content-Type': 'application/json' },
});

// 请求拦截器：添加 Token
axiosInstance.interceptors.request.use((config) => {
  const token = useUserStore.getState().token;
  if (token) {
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

// 响应拦截器：统一错误处理
axiosInstance.interceptors.response.use(
  (response) => response.data,
  (error) => {
    const status = error.response?.status;
    if (status === 401) {
      useUserStore.getState().logout();
      window.location.href = '/login';
    }
    return Promise.reject(error);
  }
);

export default axiosInstance;
```

### 4.3 错误处理统一化

```typescript
// constants/utils.ts

/** 检查 API 响应码 */
export function checkResCode(res: ApiResponse<unknown>): void {
  if (!res) throw new Error('响应数据为空');
  const successCodes = [200, 0, '200', '0'];
  if (!successCodes.includes(res.code)) {
    const errorMsg = res.message || '请求失败';
    message.error(errorMsg);
    throw new Error(errorMsg);
  }
}

/** 解包 API 响应数据 */
export function unwrap<T>(res: ApiResponse<T> | T): T {
  if (res && typeof res === 'object' && 'data' in res) {
    return (res as ApiResponse<T>).data;
  }
  return res as T;
}

// ✅ 标准调用方式（在 Hook 中使用）
const res = await getJobList<ApiResponse<JobData[]>>();
checkResCode(res); // 校验
return unwrap(res); // 解包
```


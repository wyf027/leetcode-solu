// hooks/buser/dashboard/useDashboardPage.ts

import { useEffect, useCallback, useMemo, useState } from 'react';
import { useRouter } from 'next/navigation';
import { message } from 'antd';
import useSWR from 'swr';
import { checkResCode, unwrap } from '@/constants/utils';
import {
  useWorkbenchData,
  useAllBUserList,
  useDeleteJobPosition,
} from './baseHooks';
import { getJobPositionPage } from '@/services/buser/dashboard';
import type { JobPositionItem } from '@/types/buser/dashboard';

/**
 * 工作台页面 - 聚合 Hook
 *
 * ✅ 整合所有数据获取逻辑
 * ✅ 处理所有事件回调
 * ✅ 管理组件状态
 * ✅ 使用 checkResCode + unwrap 统一 API 响应处理
 */
export function useDashboardPage() {
  const router = useRouter();

  // 状态
  const [searchType, setSearchType] = useState<'title' | 'jobCode'>('title');
  const [searchValue, setSearchValue] = useState('');
  const [pagination, setPagination] = useState({ current: 1, size: 10 });

  // 数据获取
  const { data: workbenchData, loading } = useWorkbenchData();
  const { data: bUserList } = useAllBUserList();
  const { deleteJobPosition } = useDeleteJobPosition();

  // SWR 分页数据
  const { data: jobPageData, mutate } = useSWR(
    ['jobPositionPage', pagination],
    async ([, params]) => {
      const res = await getJobPositionPage(params);
      checkResCode(res);
      return unwrap(res);
    },
    { dedupingInterval: 10000, revalidateOnFocus: false }
  );

  // 事件处理器
  const handleEdit = useCallback(
    (id: string) => {
      router.push(`/buser/jobsCreate/${id}`);
    },
    [router]
  );

  const handleDelete = useCallback(
    async (id: string) => {
      try {
        const res = await deleteJobPosition(id);
        checkResCode(res);
        message.success('已删除职位');
        mutate();
      } catch (e) {
        console.warn('删除失败:', e);
      }
    },
    [deleteJobPosition, mutate]
  );

  // 返回统一接口
  return {
    initialLoading: loading,
    workbenchData,
    bUserList,
    positionCards: jobPageData?.records ?? [],
    handlers: { onEdit: handleEdit, onDelete: handleDelete },
    searchHandlers: {
      onSearch: () => setPagination((prev) => ({ ...prev, current: 1 })),
      onPageChange: (current: number, size: number) =>
        setPagination({ current, size }),
      onReset: () => {
        setSearchValue('');
        setPagination({ current: 1, size: 10 });
      },
    },
  };
}
```


### 1.5 依赖倒置原则

```typescript
// ❌ 错误：组件直接依赖具体 API 实现
function JobsList() {
  const [jobs, setJobs] = useState([]);
  useEffect(() => {
    fetch('/api/jobs').then(res => res.json()).then(data => setJobs(data));
  }, []);
  return jobs.map(job => <JobCard key={job.id} job={job} />);
}

// ✅ 正确：组件依赖抽象接口（Props），逻辑由 Hook 提供
interface JobsListProps {
  jobs: Job[];
  onEdit?: (id: string) => void;
  onDelete?: (id: string) => void;
}

function JobsList({ jobs, onEdit, onDelete }: JobsListProps) {
  return jobs.map(job => (
    <JobCard key={job.id} job={job} onEdit={onEdit} onDelete={onDelete} />
  ));
}

// 页面组装
function JobsPage() {
  const { jobs, handleEdit, handleDelete } = useJobsPage();
  return <JobsList jobs={jobs} onEdit={handleEdit} onDelete={handleDelete} />;
}
```


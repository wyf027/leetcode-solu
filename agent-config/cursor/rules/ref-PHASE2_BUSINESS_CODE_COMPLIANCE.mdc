### 2.4 组件结构模板

```typescript
'use client';

// ==================== 导入区 ====================
// 1. React 核心
import React, { useState, useCallback, useMemo } from 'react';

// 2. Next.js 相关
import { useRouter } from 'next/navigation';
import Image from 'next/image';

// 3. 第三方库
import { Button, Modal, message } from 'antd';
import { PlusOutlined } from '@ant-design/icons';

// 4. 项目内部
import { useJobsPage } from '@/hooks/buser/jobs';
import type { JobsListProps } from '@/types/buser/jobs';

// ==================== 类型定义 ====================
interface JobsListProps {
  /** 职位列表数据 */
  positions: Position[];
  /** 是否加载中 */
  loading?: boolean;
  /** 编辑回调 */
  onEdit?: (id: string) => void;
}

// ==================== 常量定义 ====================
const ITEMS_PER_PAGE = 10;

/**
 * 职位列表组件
 *
 * @example
 * <JobsList positions={positions} loading={false} onEdit={handleEdit} />
 */
export default function JobsList({
  positions,
  loading = false,
  onEdit,
}: JobsListProps) {
  // ==================== Hooks ====================
  const router = useRouter();
  const [selectedId, setSelectedId] = useState<string | null>(null);

  // ==================== 派生状态 ====================
  const isEmpty = useMemo(
    () => !loading && positions.length === 0,
    [loading, positions.length]
  );

  // ==================== 事件处理器 ====================
  const handleEdit = useCallback((id: string) => {
    onEdit?.(id);
  }, [onEdit]);

  // ==================== 条件渲染 ====================
  if (loading) return <Spin size="large" />;
  if (isEmpty) return <Empty description="暂无职位数据" />;

  // ==================== 主渲染 ====================
  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {positions.map((position) => (
        <JobCard key={position.id} data={position} onEdit={() => handleEdit(position.id)} />
      ))}
    </div>
  );
}

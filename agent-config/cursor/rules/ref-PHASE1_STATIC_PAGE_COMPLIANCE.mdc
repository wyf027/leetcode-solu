### 1.3 页面文件模板

```typescript
// app/buser/dashboard/page.tsx
'use client';

import { Spin } from 'antd';
import {
  UserGreeting,
  StatsCards,
  EmployeeList,
  PublishedPositions,
} from '@/components/buser/dashboard';
import { useDashboardPage } from '@/hooks/buser/dashboard';

/**
 * 工作台页面
 *
 * 阶段一关注点：
 * ✅ 页面结构清晰（header + content + footer）
 * ✅ 使用设计令牌中的间距（p-8）
 * ✅ 加载状态处理（Spin）
 * ✅ 语义化的组件拆分
 */
export default function DashboardPage() {
  const { initialLoading, ...pageData } = useDashboardPage();

  if (initialLoading) {
    return (
      <div className="flex h-64 w-full items-center justify-center">
        <Spin size="large" />
      </div>
    );
  }

  return (
    <div className="w-full p-8">
      {/* 问候语区域 */}
      <UserGreeting offerCount={pageData.workbenchData?.offerNum ?? 0} />

      {/* 统计卡片区域 - 间距 mb-6 */}
      <StatsCards stats={pageData.workbenchData} />

      {/* 内容区域 */}
      <EmployeeList
        bUserList={pageData.bUserList}
        jobPosiList={pageData.jobPosiList}
      />

      <PublishedPositions positions={pageData.positionCards} />
    </div>
  );
}
```


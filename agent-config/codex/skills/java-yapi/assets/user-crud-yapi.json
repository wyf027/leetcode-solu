{
  "openapi": "3.0.1",
  "info": {
    "title": "{服务名} API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "用户管理" },
    { "name": "角色管理" }
  ],
  "paths": {
    "/user/{id}": {
      "get": {
        "tags": ["用户管理"],
        "summary": "根据 ID 查询用户详情",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_UserVO" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["用户管理"],
        "summary": "删除用户",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": ["用户管理"],
        "summary": "分页查询用户列表",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码，默认 1",
            "schema": { "type": "integer", "default": 1,  "example": 1,  "mock": { "mock": 1  } }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10",
            "schema": { "type": "integer", "default": 10, "example": 10, "mock": { "mock": 10 } }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "用户名（模糊匹配）",
            "schema": { "type": "string", "example": "张伟", "mock": { "mock": "@cname" } }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "状态：0禁用 / 1启用",
            "schema": { "type": "integer", "example": 1, "mock": { "mock": 1 } }
          }
        ],
        "responses": {
          "200": {
            "description": "分页用户列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Paged_UserVO" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["用户管理"],
        "summary": "新增用户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增用户 ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Long" }
              }
            }
          }
        }
      }
    },
    "/user/{id}/status": {
      "patch": {
        "tags": ["用户管理"],
        "summary": "更新用户状态",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserStatusUpdateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserCreateDTO": {
        "type": "object",
        "description": "新增用户请求体",
        "required": ["name", "status"],
        "properties": {
          "name":   { "type": "string",  "description": "用户名（必填）",            "example": "张伟",                 "mock": { "mock": "@cname"                       } },
          "email":  { "type": "string",  "description": "邮箱（选填）",              "example": "zhangwei@example.com", "mock": { "mock": "@email"                       } },
          "phone":  { "type": "string",  "description": "手机号（选填）",            "example": "13800138000",          "mock": { "mock": "@string('number', 11)"         } },
          "status": { "type": "integer", "description": "状态：0禁用 / 1启用（必填）","example": 1,                      "mock": { "mock": 1                              } },
          "remark": { "type": "string",  "description": "备注（选填）",              "example": "普通用户",             "mock": { "mock": "@ctitle(4, 8)"                } }
        }
      },
      "UserStatusUpdateDTO": {
        "type": "object",
        "description": "用户状态更新请求体",
        "required": ["status"],
        "properties": {
          "status": { "type": "integer", "description": "状态：0禁用 / 1启用（必填）", "example": 1, "mock": { "mock": 1 } }
        }
      },
      "UserVO": {
        "type": "object",
        "description": "用户视图",
        "properties": {
          "id":         { "type": "string",  "description": "用户 ID（雪花ID，序列化为字符串）",     "example": "1947283920182378496",  "mock": { "mock": "@string('number', 18)"            } },
          "name":       { "type": "string",  "description": "用户名",                              "example": "张伟",                 "mock": { "mock": "@cname"                           } },
          "email":      { "type": "string",  "description": "邮箱",                                "example": "zhangwei@example.com", "mock": { "mock": "@email"                           } },
          "phone":      { "type": "string",  "description": "手机号",                              "example": "13800138000",          "mock": { "mock": "@string('number', 11)"             } },
          "statusCode": { "type": "integer", "description": "状态码：0禁用 / 1启用",                "example": 1,                      "mock": { "mock": 1                                  } },
          "statusDesc": { "type": "string",  "description": "状态描述",                            "example": "启用",                 "mock": { "mock": "启用"                             } },
          "remark":     { "type": "string",  "description": "备注",                                "example": "普通用户",             "mock": { "mock": "@ctitle(4, 8)"                    } },
          "createTime": { "type": "string",  "description": "创建时间 yyyy-MM-dd HH:mm:ss",        "example": "2024-03-21 10:30:00",  "mock": { "mock": "@datetime('yyyy-MM-dd HH:mm:ss')" } },
          "updateTime": { "type": "string",  "description": "更新时间 yyyy-MM-dd HH:mm:ss",        "example": "2024-03-21 14:00:00",  "mock": { "mock": "@datetime('yyyy-MM-dd HH:mm:ss')" } }
        }
      },
      "Result_UserVO": {
        "type": "object",
        "description": "单对象响应包装",
        "properties": {
          "code":    { "type": "integer", "description": "状态码，0为成功", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",                                    "example": "success", "mock": { "mock": "success" } },
          "data":    { "$ref": "#/components/schemas/UserVO" }
        }
      },
      "Result_Paged_UserVO": {
        "type": "object",
        "description": "分页响应包装",
        "properties": {
          "code":    { "type": "integer", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",  "example": "success", "mock": { "mock": "success" } },
          "data": {
            "type": "object",
            "properties": {
              "list":     { "type": "array", "items": { "$ref": "#/components/schemas/UserVO" } },
              "total":    { "type": "integer", "description": "总条数",   "example": 100, "mock": { "mock": 100 } },
              "pageNum":  { "type": "integer", "description": "当前页码", "example": 1,   "mock": { "mock": 1   } },
              "pageSize": { "type": "integer", "description": "每页条数", "example": 10,  "mock": { "mock": 10  } }
            }
          }
        }
      },
      "Result_Long": {
        "type": "object",
        "description": "Long 类型响应包装（雪花ID场景）",
        "properties": {
          "code":    { "type": "integer", "example": 0,                        "mock": { "mock": 0                           } },
          "message": { "type": "string",  "example": "success",                "mock": { "mock": "success"                   } },
          "data":    { "type": "string",  "description": "新增 ID（雪花ID，字符串）", "example": "1947283920182378496", "mock": { "mock": "@string('number', 18)" } }
        }
      },
      "Result_Void": {
        "type": "object",
        "description": "无返回值响应包装",
        "properties": {
          "code":    { "type": "integer", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",  "example": "success", "mock": { "mock": "success" } },
          "data":    { "type": "object",  "nullable": true }
        }
      }
    }
  }
}

{
  "openapi": "3.0.1",
  "info": {
    "title": "hire API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "职位配置" },
    { "name": "标签" }
  ],
  "paths": {

    "/job/config": {
      "post": {
        "tags": ["职位配置"],
        "summary": "职位配置 - 保存或更新（含基本信息、候选人画像、业务补充三步）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobInfoDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "职位 ID（雪花ID）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Long" }
              }
            }
          }
        }
      }
    },

    "/job/config/page": {
      "get": {
        "tags": ["职位配置"],
        "summary": "职位 - 分页查询（统一入口，通过 scene 参数切换模式）",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码，默认 1",
            "schema": { "type": "integer", "default": 1,  "example": 1,  "mock": { "mock": 1  } }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10",
            "schema": { "type": "integer", "default": 10, "example": 10, "mock": { "mock": 10 } }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "职位名称（模糊匹配）",
            "schema": { "type": "string", "example": "Java 工程师", "mock": { "mock": "@ctitle(4, 8)" } }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "description": "职位编码（精确匹配）",
            "schema": { "type": "string", "example": "RD-2026-001", "mock": { "mock": "RD-2026-001" } }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "职级标识，如 M3/P4（精确匹配）",
            "schema": { "type": "string", "example": "P5", "mock": { "mock": "P5" } }
          },
          {
            "name": "departmentId",
            "in": "query",
            "required": false,
            "description": "部门 ID（精确匹配）",
            "schema": { "type": "string", "example": "1947283920182378496", "mock": { "mock": "@string('number', 18)" } }
          },
          {
            "name": "positionLevel",
            "in": "query",
            "required": false,
            "description": "职位等级：1.初级 2.中级 3.高级 4.专家",
            "schema": { "type": "integer", "example": 2, "mock": { "mock": 2 } }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "职位类型（存枚举 desc，如 Java工程师）",
            "schema": { "type": "string", "example": "Java工程师", "mock": { "mock": "Java工程师" } }
          },
          {
            "name": "recruitType",
            "in": "query",
            "required": false,
            "description": "招聘类型：1.社招 2.校招 3.实习",
            "schema": { "type": "integer", "example": 1, "mock": { "mock": 1 } }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "职位状态：0.草稿 1.招聘中 2.待发布 5.已关闭",
            "schema": { "type": "integer", "example": 1, "mock": { "mock": 1 } }
          },
          {
            "name": "workLocation",
            "in": "query",
            "required": false,
            "description": "工作地点（模糊匹配）",
            "schema": { "type": "string", "example": "上海", "mock": { "mock": "@city" } }
          },
          {
            "name": "scene",
            "in": "query",
            "required": false,
            "description": "查询场景：DEFAULT（通用）/ HISTORY（历史）/ PUBLISHED（已发布）/ DEPARTMENT（按部门）",
            "schema": { "type": "string", "example": "DEFAULT", "mock": { "mock": "DEFAULT" } }
          }
        ],
        "responses": {
          "200": {
            "description": "分页职位列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Paged_JobListDTO" }
              }
            }
          }
        }
      }
    },

    "/job/config/preset/search": {
      "get": {
        "tags": ["职位配置"],
        "summary": "职位预设 - 搜索（关键词模糊匹配，返回名称、必备能力与加分项）",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "搜索关键词（可为空，为空时返回全量预设）",
            "schema": { "type": "string", "default": "", "example": "Java", "mock": { "mock": "Java" } }
          }
        ],
        "responses": {
          "200": {
            "description": "匹配的职位预设列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_List_PositionPresetDTO" }
              }
            }
          }
        }
      }
    },

    "/job/config/dashboard": {
      "get": {
        "tags": ["职位配置"],
        "summary": "招聘工作台 - 看板数据（需企业上下文）",
        "responses": {
          "200": {
            "description": "看板统计数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_JobConfigDashboardDTO" }
              }
            }
          }
        }
      }
    },

    "/job/config/stats": {
      "get": {
        "tags": ["职位配置"],
        "summary": "岗位 - 统计信息（需企业上下文）",
        "responses": {
          "200": {
            "description": "岗位状态统计",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_JobConfigStatsDTO" }
              }
            }
          }
        }
      }
    },

    "/job/config/{id}": {
      "get": {
        "tags": ["职位配置"],
        "summary": "职位 - 详情查询",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "职位详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_JobInfoDTO" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["职位配置"],
        "summary": "职位 - 删除（逻辑删除，需企业上下文）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/job/config/jd/{id}": {
      "get": {
        "tags": ["职位配置"],
        "summary": "职位 JD - 内容获取（兼顾轮询和直取场景）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JD 内容（生成中时仅返回 status 字段）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_JdContentDTO" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["职位配置"],
        "summary": "职位 - 发布（落库 JD 并变更状态为已发布）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobPublishDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/job/config/status/{id}": {
      "patch": {
        "tags": ["职位配置"],
        "summary": "职位 - 状态更新（status=5 关闭 / status=1 重开，需企业上下文）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobStatusUpdateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/job/config/salary/{id}": {
      "patch": {
        "tags": ["职位配置"],
        "summary": "职位 - 薪资范围修改（需企业上下文）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobSalaryUpdateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/job/config/expire-date/{id}": {
      "patch": {
        "tags": ["职位配置"],
        "summary": "职位 - 截止日期修改（需企业上下文）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "职位 ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobExpireDateUpdateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/job/config/department/{departmentId}": {
      "get": {
        "tags": ["职位配置"],
        "summary": "岗位 - 按部门列表查询（同名职位去重，取最近更新）",
        "parameters": [
          {
            "name": "departmentId",
            "in": "path",
            "required": true,
            "description": "部门 ID（雪花ID）",
            "schema": {
              "type": "string",
              "example": "1947283920182378497",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "去重后的岗位列表（同部门同名职位只保留最近更新一条）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_List_JobListDTO" }
              }
            }
          }
        }
      }
    },

    "/tag/page": {
      "get": {
        "tags": ["标签"],
        "summary": "标签 - 分页查询（启用）",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "关键词（可选，为空时不过滤）",
            "schema": { "type": "string", "example": "Java", "mock": { "mock": "Java" } }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "description": "当前页码，默认 1",
            "schema": { "type": "integer", "default": 1, "example": 1, "mock": { "mock": 1 } }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 20",
            "schema": { "type": "integer", "default": 20, "example": 20, "mock": { "mock": 20 } }
          }
        ],
        "responses": {
          "200": {
            "description": "分页标签列表（data 为 Paged，records 项为 TagListDTO）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Paged_TagListDTO" }
              }
            }
          }
        }
      }
    }

  },

  "components": {
    "schemas": {

      "JobInfoDTO": {
        "type": "object",
        "description": "职位信息 DTO，兼作创建/更新入参与详情出参",
        "properties": {
          "id":              { "type": "string",  "description": "职位主键（更新时传入，创建时不传）",           "example": "1947283920182378496",  "mock": { "mock": "@string('number', 18)"            } },
          "companyId":       { "type": "string",  "description": "企业 ID（雪花ID）",                          "example": "1947283920182378496",  "mock": { "mock": "@string('number', 18)"            } },
          "departmentId":    { "type": "string",  "description": "部门 ID（雪花ID）",                          "example": "1947283920182378497",  "mock": { "mock": "@string('number', 18)"            } },
          "code":            { "type": "string",  "description": "职位编码",                                   "example": "RD-2026-001",          "mock": { "mock": "RD-2026-001"                     } },
          "name":            { "type": "string",  "description": "职位名称",                                   "example": "高级 Java 工程师",     "mock": { "mock": "@ctitle(4, 8)"                   } },
          "type":            { "type": "string",  "description": "职位类型（存枚举 desc）",                    "example": "Java工程师",           "mock": { "mock": "Java工程师"                      } },
          "recruitType":     { "type": "integer", "description": "招聘类型：1.社招 2.校招 3.实习",             "example": 1,                      "mock": { "mock": 1                                 } },
          "recruitTypeDesc": { "type": "string",  "description": "招聘类型描述",                               "example": "社招",                 "mock": { "mock": "社招"                            } },
          "status":          { "type": "integer", "description": "状态：0草稿 1.招聘中 2.待发布 5.已关闭",    "example": 1,                      "mock": { "mock": 1                                 } },
          "statusDesc":      { "type": "string",  "description": "状态描述",                                   "example": "招聘中",               "mock": { "mock": "招聘中"                          } },
          "likeCount":       { "type": "integer", "description": "收藏总数",                                   "example": 18,                     "mock": { "mock": "@integer(0, 100)"                } },
          "candidateCount":  { "type": "integer", "description": "候选人总数",                                 "example": 36,                     "mock": { "mock": "@integer(0, 200)"                } },
          "basicInfo":       { "$ref": "#/components/schemas/JobBasicInfoDTO" },
          "candidateProfile":   { "$ref": "#/components/schemas/JobCandidateProfileDTO" },
          "businessSupplement": { "$ref": "#/components/schemas/JobBusinessSupplementDTO" },
          "jdContent":       { "type": "string",  "description": "AI 生成的 JD 内容（JSON 字符串）",           "example": "{\"title\":\"高级Java工程师\"}", "mock": { "mock": "{}" } },
          "jdFileId":        { "type": "string",  "description": "用户修改后上传的 JD 文件 ID（雪花ID）",     "example": "1947283920182378498",  "mock": { "mock": "@string('number', 18)"            } },
          "createdAt":       { "type": "string",  "description": "创建时间 yyyy-MM-dd HH:mm:ss",               "example": "2026-03-16 10:00:00",  "mock": { "mock": "@datetime('yyyy-MM-dd HH:mm:ss')" } },
          "updatedAt":       { "type": "string",  "description": "最后更新时间 yyyy-MM-dd HH:mm:ss",           "example": "2026-03-21 14:00:00",  "mock": { "mock": "@datetime('yyyy-MM-dd HH:mm:ss')" } }
        }
      },

      "JobBasicInfoDTO": {
        "type": "object",
        "description": "职位基本信息（对应 JobInfoDTO.basicInfo，第一步）",
        "properties": {
          "code":                 { "type": "string",  "description": "职位编码",                                     "example": "RD-2026-001",         "mock": { "mock": "RD-2026-001"                     } },
          "name":                 { "type": "string",  "description": "职位名称",                                     "example": "高级 Java 工程师",    "mock": { "mock": "@ctitle(4, 8)"                   } },
          "type":                 { "type": "string",  "description": "职位类型（存枚举 desc）",                      "example": "Java工程师",          "mock": { "mock": "Java工程师"                      } },
          "departmentId":         { "type": "string",  "description": "部门 ID（雪花ID）",                           "example": "1947283920182378497", "mock": { "mock": "@string('number', 18)"            } },
          "recruitType":          { "type": "integer", "description": "招聘类型：1.社招 2.校招 3.实习",               "example": 1,                     "mock": { "mock": 1                                 } },
          "companyName":          { "type": "string",  "description": "公司名称",                                     "example": "示例科技有限公司",    "mock": { "mock": "@ctitle(4, 8)"                   } },
          "companyDescription":   { "type": "string",  "description": "公司描述",                                     "example": "专注于企业 HR 数字化", "mock": { "mock": "@cparagraph(1)"                  } },
          "onboardDate":          { "type": "string",  "description": "到岗日期 yyyy-MM-dd",                          "example": "2026-04-01",          "mock": { "mock": "@date('yyyy-MM-dd')"             } },
          "expireDate":           { "type": "string",  "description": "截止日期 yyyy-MM-dd",                          "example": "2026-06-30",          "mock": { "mock": "@date('yyyy-MM-dd')"             } },
          "workLocation":         { "type": "string",  "description": "工作地点",                                     "example": "上海市",              "mock": { "mock": "@city"                           } },
          "jobSequence":          { "type": "string",  "description": "职位序列",                                     "example": "技术",                "mock": { "mock": "技术"                            } },
          "salaryMin":            { "type": "number",  "description": "最低薪资（万/年）",                            "example": 20.00,                 "mock": { "mock": "@float(10, 30, 2, 2)"             } },
          "salaryMax":            { "type": "number",  "description": "最高薪资（万/年）",                            "example": 35.00,                 "mock": { "mock": "@float(30, 60, 2, 2)"             } },
          "level":                { "type": "string",  "description": "职级标识，如 P5/M3",                           "example": "P5",                  "mock": { "mock": "P5"                              } },
          "positionLevel":        { "type": "integer", "description": "职位等级：1.初级 2.中级 3.高级 4.专家",        "example": 3,                     "mock": { "mock": 3                                 } },
          "description":          { "type": "string",  "description": "职位描述",                                     "example": "负责后端服务开发",    "mock": { "mock": "@cparagraph(2)"                  } },
          "requirements":         { "type": "string",  "description": "任职要求",                                     "example": "3年以上 Java 经验",   "mock": { "mock": "@cparagraph(2)"                  } },
          "employeeBenefits":     { "type": "string",  "description": "员工福利",                                     "example": "五险一金+补充医疗",   "mock": { "mock": "@cparagraph(1)"                  } },
          "headCount":            { "type": "integer", "description": "招聘人数",                                     "example": 2,                     "mock": { "mock": "@integer(1, 10)"                 } },
          "educationRequirement": { "type": "integer", "description": "学历要求：1.不限 2.大专及以上 3.本科及以上 4.硕士及以上 5.博士及以上", "example": 3, "mock": { "mock": 3 } },
          "educationType":        { "type": "integer", "description": "学历类型：1.全日制 2.非全日制",                "example": 1,                     "mock": { "mock": 1                                 } },
          "preferredSchools":     { "type": "array",   "description": "偏好院校（多选）：1.985重点本科 2.211高校 3.双一流大学 4.双一流学科 5.重点本科 6.普通本科 7.海外名校(QS前100) 8.海外名校(QS前300) 9.港澳台高校 10.行业特色高校 11.不限", "items": { "type": "integer", "mock": { "mock": "@integer(1, 11)" } }, "example": [1, 2] },
          "ageRequirement":       { "type": "string",  "description": "年龄要求，如 35岁以下",                         "example": "35岁以下",            "mock": { "mock": "35岁以下"                        } },
          "materialFileIds": {
            "type": "array",
            "description": "资料文件 ID 列表（仅通用职位使用，雪花ID数组）",
            "items": { "type": "string", "example": "1947283920182378496", "mock": { "mock": "@string('number', 18)" } }
          }
        }
      },

      "JobCandidateProfileDTO": {
        "type": "object",
        "description": "候选人画像（对应 JobInfoDTO.candidateProfile，第二步）",
        "properties": {

{
  "openapi": "3.0.1",
  "info": {
    "title": "{服务名，如 hire / assess / system} API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "{YApi 分类名，必须与 YApi 现有分类名完全一致}" },
    { "name": "{第二个分类}" }
  ],
  "paths": {

    "/{resource}": {
      "get": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 分页查询",
        "parameters": [
          {
            "name": "current",
            "in": "query",
            "required": false,
            "description": "当前页码，默认 1（Pageable）",
            "schema": { "type": "integer", "default": 1,  "example": 1,  "mock": { "mock": 1  } }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10（Pageable）",
            "schema": { "type": "integer", "default": 10, "example": 10, "mock": { "mock": 10 } }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "名称（可选，模糊匹配）",
            "schema": { "type": "string", "example": "示例名称", "mock": { "mock": "@ctitle(4, 8)" } }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "状态筛选（枚举，全部值必须列出）：0.草稿 / 1.审核中 / 2.已通过 / 3.已拒绝 / 4.已关闭",
            "schema": { "type": "integer", "enum": [0, 1, 2, 3, 4], "example": 0, "mock": { "mock": 0 } }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "类型（字符串枚举，存 desc，全部值必须列出）：社招 / 校招 / 实习",
            "schema": { "type": "string", "enum": ["社招", "校招", "实习"], "example": "社招", "mock": { "mock": "社招" } }
          }
        ],
        "responses": {
          "200": {
            "description": "分页{资源}列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Paged_{Xxx}VO" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 新增",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/{Xxx}CreateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增{资源} ID（雪花ID）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Long" }
              }
            }
          }
        }
      }
    },

    "/{resource}/{id}": {
      "get": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 详情查询（按 ID）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "{资源} ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{资源}详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_{Xxx}VO" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 删除（逻辑删除）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "{资源} ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/{resource}/update/{id}": {
      "post": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 信息更新",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "{资源} ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/{Xxx}UpdateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/{resource}/status/{id}": {
      "patch": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 状态更新",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "{资源} ID",
            "schema": {
              "type": "string",
              "example": "1947283920182378496",
              "mock": { "mock": "@string('number', 18)" }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/{Xxx}StatusUpdateDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_Void" }
              }
            }
          }
        }
      }
    },

    "/{resource}/names": {
      "get": {
        "tags": ["{分类名}"],
        "summary": "{资源} - 名称列表查询（无分页）",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "搜索关键词（为空时返回全量）",
            "schema": { "type": "string", "example": "Java", "mock": { "mock": "@ctitle(2, 5)" } }
          }
        ],
        "responses": {
          "200": {
            "description": "{资源}名称列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_List_{Xxx}VO" }
              }
            }
          }
        }
      }
    },

    "/{resource}/dashboard": {
      "get": {
        "tags": ["{分类名}"],
        "summary": "{业务名} - 看板统计（无分页，无入参）",
        "responses": {
          "200": {
            "description": "看板数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result_{Xxx}DashboardVO" }
              }
            }
          }
        }
      }
    }

  },

  "components": {
    "schemas": {

      "{Xxx}CreateDTO": {
        "type": "object",
        "description": "新增{资源}请求体",
        "required": ["name", "status", "recruitType"],
        "properties": {
          "name":        { "type": "string",  "description": "{资源}名称（必填，@NotBlank）",                                                         "example": "高级 Java 工程师", "mock": { "mock": "@ctitle(4, 8)" } },
          "status":      { "type": "integer", "enum": [0, 1, 2, 3, 4],              "description": "状态（必填，@NotNull；整数枚举，全部值必须列出）：0.草稿 / 1.审核中 / 2.已通过 / 3.已拒绝 / 4.已关闭", "example": 0,      "mock": { "mock": 0      } },
          "recruitType": { "type": "string",  "enum": ["社招", "校招", "实习"],  "description": "招聘类型（必填，@NotBlank；字符串枚举存 desc，全部值必须列出）：社招 / 校招 / 实习",                  "example": "社招", "mock": { "mock": "社招" } },
          "remark":      { "type": "string",  "description": "备注（选填）",                                                                         "example": "普通备注",         "mock": { "mock": "@ctitle(4, 8)" } }
        }
      },

      "{Xxx}UpdateDTO": {
        "type": "object",
        "description": "更新{资源}请求体，只传需要修改的字段",
        "properties": {
          "name":   { "type": "string",  "description": "{资源}名称",  "example": "高级 Java 工程师", "mock": { "mock": "@ctitle(4, 8)" } },
          "remark": { "type": "string",  "description": "备注",        "example": "修改后备注",       "mock": { "mock": "@ctitle(4, 8)" } }
        }
      },

      "{Xxx}StatusUpdateDTO": {
        "type": "object",
        "description": "状态更新请求体",
        "required": ["status"],
        "properties": {
          "status": { "type": "integer", "enum": [0, 1, 2, 3, 4], "description": "目标状态（必填，@NotNull；枚举全部值必须列出）：0.草稿 / 1.审核中 / 2.已通过 / 3.已拒绝 / 4.已关闭", "example": 0, "mock": { "mock": 0 } }
        }
      },

      "{Xxx}VO": {
        "type": "object",
        "description": "{资源}视图对象",
        "properties": {
          "id":          { "type": "string",  "description": "{资源} ID（雪花ID，序列化为字符串）",                                                   "example": "1947283920182378496", "mock": { "mock": "@string('number', 18)"            } },
          "name":        { "type": "string",  "description": "{资源}名称",                                                                            "example": "高级 Java 工程师",    "mock": { "mock": "@ctitle(4, 8)"                    } },
          "recruitType": { "type": "string",  "enum": ["社招", "校招", "实习"],                        "description": "招聘类型（字符串枚举，全部值必须列出）：社招 / 校招 / 实习",                             "example": "社招", "mock": { "mock": "社招" } },
          "statusCode":  { "type": "integer", "enum": [0, 1, 2, 3, 4],                               "description": "状态码（整数枚举，全部值必须列出）：0.草稿 / 1.审核中 / 2.已通过 / 3.已拒绝 / 4.已关闭", "example": 0,      "mock": { "mock": 0      } },
          "statusDesc":  { "type": "string",  "enum": ["草稿", "审核中", "已通过", "已拒绝", "已关闭"], "description": "状态描述（与 statusCode 一一对应）：草稿 / 审核中 / 已通过 / 已拒绝 / 已关闭",           "example": "草稿", "mock": { "mock": "草稿" } },
          "remark":      { "type": "string",  "description": "备注",                                                                                  "example": "示例备注",            "mock": { "mock": "@ctitle(4, 8)"                    } },
          "createTime":  { "type": "string",  "description": "创建时间 yyyy-MM-dd HH:mm:ss",                                                          "example": "2026-03-21 10:30:00", "mock": { "mock": "@datetime('yyyy-MM-dd HH:mm:ss')" } },
          "updateTime":  { "type": "string",  "description": "更新时间 yyyy-MM-dd HH:mm:ss",                                                          "example": "2026-03-21 14:00:00", "mock": { "mock": "@datetime('yyyy-MM-dd HH:mm:ss')" } }
        }
      },

      "{Xxx}DashboardVO": {
        "type": "object",
        "description": "看板统计 VO",
        "properties": {
          "totalCount":   { "type": "string",  "description": "总数量（Long 序列化为字符串）", "example": "128",  "mock": { "mock": "@string('number', 3)" } },
          "enabledCount": { "type": "string",  "description": "启用数量",                    "example": "42",   "mock": { "mock": "@string('number', 2)" } },
          "todayCount":   { "type": "string",  "description": "今日新增数量",                "example": "5",    "mock": { "mock": "@string('number', 1)" } }
        }
      },

      "Result_{Xxx}VO": {
        "type": "object",
        "description": "单对象响应包装",
        "properties": {
          "code":    { "type": "integer", "description": "状态码，0为成功", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",                                    "example": "success", "mock": { "mock": "success" } },
          "data":    { "$ref": "#/components/schemas/{Xxx}VO" }
        }
      },

      "Result_List_{Xxx}VO": {
        "type": "object",
        "description": "列表响应包装（不分页）",
        "properties": {
          "code":    { "type": "integer", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",  "example": "success", "mock": { "mock": "success" } },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/{Xxx}VO" }
          }
        }
      },

      "Result_Paged_{Xxx}VO": {
        "type": "object",
        "description": "分页响应包装；data 对齐 Paged。禁止 records/items 使用匿名 object，items 必须 $ref 至具名 {Xxx}VO 且该 VO properties 写全",
        "properties": {
          "code":    { "type": "integer", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",  "example": "success", "mock": { "mock": "success" } },
          "data": {
            "type": "object",
            "description": "Paged：records、total、size、current、pages",
            "properties": {
              "records": {
                "type": "array",
                "description": "当前页数据；items 必须 $ref 至 {Xxx}VO",
                "items": { "$ref": "#/components/schemas/{Xxx}VO" }
              },
              "total":   { "type": "integer", "description": "总条数",   "example": 100, "mock": { "mock": 100 } },
              "size":    { "type": "integer", "description": "每页条数", "example": 10,  "mock": { "mock": 10  } },
              "current": { "type": "integer", "description": "当前页码", "example": 1,   "mock": { "mock": 1   } },
              "pages":   { "type": "integer", "description": "总页数",   "example": 10,  "mock": { "mock": 10  } }
            }
          }
        }
      },

      "Result_{Xxx}DashboardVO": {
        "type": "object",
        "description": "看板数据响应包装",
        "properties": {
          "code":    { "type": "integer", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",  "example": "success", "mock": { "mock": "success" } },
          "data":    { "$ref": "#/components/schemas/{Xxx}DashboardVO" }
        }
      },

      "Result_Long": {
        "type": "object",
        "description": "Long 类型响应包装（雪花ID场景，data 序列化为字符串）",
        "properties": {
          "code":    { "type": "integer", "example": 0,                       "mock": { "mock": 0                           } },
          "message": { "type": "string",  "example": "success",               "mock": { "mock": "success"                   } },
          "data":    { "type": "string",  "description": "返回 ID（雪花ID）", "example": "1947283920182378496", "mock": { "mock": "@string('number', 18)" } }
        }
      },

      "Result_Void": {
        "type": "object",
        "description": "无返回值响应包装",
        "properties": {
          "code":    { "type": "integer", "example": 0,         "mock": { "mock": 0         } },
          "message": { "type": "string",  "example": "success", "mock": { "mock": "success" } },
          "data":    { "type": "object",  "nullable": true }
        }
      }

    }
  }
}

+    /// Run a GraphQL operation using the same private authentication as the CLI.
+    pub async fn graphql(
+        self,
+        operation_name: &'static str,
+        query: String,
+        variables: String,
+    ) -> Result<Response> {
+        let url = self.conf.sys.urls.graphql.clone();
+        let mut json: Json = HashMap::new();
+        json.insert("operationName", operation_name.to_string());
+        json.insert("query", query);
+        json.insert("variables", variables);
+        Req {
+            default_headers: self.default_headers,
+            refer: Some(self.conf.sys.urls.base),
+            info: false,
+            json: Some(json),
+            mode: Mode::Post,
+            name: operation_name,
+            url,
+        }
+        .send(&self.client)
+        .await
+    }

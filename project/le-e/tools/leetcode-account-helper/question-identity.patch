+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CatalogProblem {
+    pub id: i32,
+    pub frontend_id: String,
+    pub slug: String,
+    pub title: String,
+    pub difficulty: String,
+    pub acceptance: Option<f32>,
+    pub solve_status: String,
+    pub starred: bool,
+}
+
+impl CatalogProblem {
+    pub fn from_problem(problem: Problem, frontend_id: String) -> Self {
+        let difficulty = match problem.level {
+            1 => "Easy",
+            2 => "Medium",
+            3 => "Hard",
+            _ => "Unknown",
+        }
+        .to_string();
+        let solve_status = if problem.locked {
+            "locked"
+        } else {
+            match problem.status.as_str() {
+                "ac" => "solved",
+                "notac" => "attempted",
+                _ => "unsolved",
+            }
+        }
+        .to_string();
+        Self {
+            id: problem.id,
+            frontend_id,
+            slug: problem.slug,
+            title: problem.name,
+            difficulty,
+            acceptance: problem.percent.is_finite().then_some(problem.percent),
+            solve_status,
+            starred: problem.starred,
+        }
+    }
+}

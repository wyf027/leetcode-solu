{
  "name": "le-e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite-node src/main.ts",
    "dev:fake": "vite build --mode terminal && node dist-terminal/manualFakeTui.js",
    "build": "vite build --mode terminal",
    "start": "node dist-terminal/main.js",
    "setup:editor": "node dist-terminal/editorSetupMain.js",
    "setup:account": "node scripts/setup-account-helper.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@simon_he/vue-tui": "1.1.5",
    "sharp": "^0.35.3",
    "string-width": "8.2.2",
    "strip-ansi": "7.2.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-node": "6.0.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
